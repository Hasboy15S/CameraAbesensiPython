# CAMERA_SOURCE
# 0 untuk webcam bawaan
# Atau RTSP link (contoh: rtsp://admin:pass@192.168.1.100:554/stream)
CAMERA_SOURCE=0

# Konfigurasi AI (Default: 0.55)
SIMILARITY_THRESHOLD=0.55

# Cooldown dalam detik (Default: 300)
ATTENDANCE_COOLDOWN_SECONDS=300

# Mode Absensi: AUTO, IN, OUT
ATTENDANCE_MODE=AUTO

# Konfigurasi Telegram Bot (Opsional)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
# TELEGRAM_CHAT_ID=-1234567890
